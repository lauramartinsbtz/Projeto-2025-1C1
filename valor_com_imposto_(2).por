programa
{
	real valor, valorcit
	funcao inicio()
	{
	escreva("Digite o valor de fábrica do seu carro, use '.' quando for separar os centavos de reais:\n")
	leia(valor)

	valorcit = ((0.25*valor)*0.45)

	escreva("\nO valor do seu carro, cobrando o valor do revendedor de 25% e dos impostos de 45% é: ", valorcit )
	}
}
