programa
{
	real salario, salarior
	funcao inicio()
	{	
		escreva("Digite o seu salário, ele será aumentado em 30%:\n")    
	 leia(salario)
 enquanto (salario != 0) {

	 	salarior = (salario * 1.3)
	 
	 	escreva("\nO seu salário será: ", salarior)
	 	
	 escreva("\nSeu cálculo foi encerrado.")
	}
	}
}
