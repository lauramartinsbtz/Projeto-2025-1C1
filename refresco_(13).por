programa
{
	real agua, suco, refresco
	funcao inicio()
	{
		escreva("Informe a quantidade de litros de refresco que você deseja: ")
		leia(refresco)

		agua = refresco * 0.8
		suco = refresco * 0.2

		escreva("A quantidade de água necessária é: ", agua)
		escreva("\nA quantidade de suco necessário é: ", suco)
		
	}
}
