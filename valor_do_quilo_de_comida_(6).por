programa
{
	real quilo, valorppagar
	funcao inicio()
	{
		escreva("Escreva o peso do prato em KG:")
		leia(quilo)

		valorppagar = quilo * 12

		escreva("O valor a pagar é: R$ ", valorppagar)
	
		
	}
}
